TVEZ Android MPV 0.42: default CA roots for FFmpeg 9.0.2

Drop this single file into buildscripts/patches/ffmpeg/.
The existing patch.sh applies it. Do not combine with the multi-file CA overlay.
Android verified client connections only. Explicit CA files retain priority.
TLS and hostname validation are not changed. Bundle source and license are
in the added header. The existing native version tag is not changed.

diff --git a/libavformat/tls_mbedtls.c b/libavformat/tls_mbedtls.c
index 444148be8a07d8e5da7d2b905c28c25b44cedba5..f60b70b7bebb7569ce95f11d28309d05060c3d59 100644
--- a/libavformat/tls_mbedtls.c
+++ b/libavformat/tls_mbedtls.c
@@ -28,6 +28,10 @@
 #include <mbedtls/x509_crt.h>
 #include <mbedtls/debug.h>
 #include <mbedtls/timing.h>
+
+#ifdef __ANDROID__
+#include "tvez_android_ca_bundle.h"
+#endif
 #ifdef MBEDTLS_PSA_CRYPTO_C
 #include <psa/crypto.h>
 #endif
@@ -556,6 +560,18 @@ static int tls_open(URLContext *h, const char *uri, int flags, AVDictionary **op
             goto fail;
         }
     }
+#ifdef __ANDROID__
+    else if (shr->verify && !shr->listen) {
+        ret = mbedtls_x509_crt_parse(&tls_ctx->ca_cert,
+                                     tvez_android_ca_bundle,
+                                     sizeof(tvez_android_ca_bundle));
+        if (ret != 0) {
+            av_log(h, AV_LOG_ERROR, "TVEZ Android CA bundle parse failed: %d\n", ret);
+            goto fail;
+        }
+        av_log(h, AV_LOG_VERBOSE, "TVEZ Android bundled CA roots loaded\n");
+    }
+#endif
 
     // load own certificate
     if (shr->cert_file) {
